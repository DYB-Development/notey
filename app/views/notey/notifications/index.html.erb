<%= render "notey/live_stream", person: Notey::Current.member, account: Notey::Current.account_id %>

<%= ui_page(max_width: :lg) do %>
  <%= ui_section(title: "Notifications", subtitle: safe_join([ render("notey/unread_count", person: Notey::Current.member, account: Notey::Current.account_id), " unread" ])) do %>
    <div id="notey_inbox">
      <% @notifications.each do |notification| %>
        <%= render "notey/notification", notification: notification, submit_url: notification_path(notification) %>
      <% end %>
    </div>
  <% end %>
<% end %>
